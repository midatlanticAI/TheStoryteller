{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Variant for the Workers Paid plan: the Game Master runs as a Cloudflare Container instead of on your own Docker.
  // Deploy with: wrangler deploy -c wrangler.containers.jsonc
  "name": "storyteller-ttop",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "ttop.shannara.midatlantic.ai", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "CampaignRoom" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "GM", "class_name": "GameMaster" }
    ]
  },
  "containers": [
    {
      "class_name": "GameMaster",
      "image": "../gm/Dockerfile",
      "image_build_context": "../gm",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CampaignRoom", "Lobby"] },
    { "tag": "v2", "new_sqlite_classes": ["GameMaster"] }
  ],
  "vars": {
    "DAILY_TURN_LIMIT": "400",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
